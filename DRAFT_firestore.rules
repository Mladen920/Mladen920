rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Default Deny Catch-All
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Global Helper Functions
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == "mladjo_992@hotmail.com" && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isValidOptionalNumber(data, field) {
      return !(field in data) || (data[field] is number && data[field] >= 0);
    }

    // ===============================================================
    // Users Collection (/users/{userId})
    // ===============================================================
    function isValidUserSchema(data, userId) {
      let requiredKeys = ['id', 'username', 'fullName', 'role'];
      let allowedKeys = ['id', 'username', 'fullName', 'role', 'password', 'hourlyRate', 'permissions', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(requiredKeys) &&
             data.keys().hasOnly(allowedKeys) &&
             data.id == userId &&
             data.username is string && data.username.size() >= 1 && data.username.size() <= 100 &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 150 &&
             data.role in ['admin', 'worker'] &&
             isValidOptionalNumber(data, 'hourlyRate') &&
             isValidOptionalString(data, 'password', 128) &&
             isValidOptionalString(data, 'createdAt', 64) &&
             isValidOptionalString(data, 'updatedAt', 64) &&
             (!( 'permissions' in data ) || data.permissions is map);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(userId) &&
                       isValidUserSchema(incoming(), userId) &&
                       (isAdmin() || (isOwner(userId) && incoming().role == 'worker'));
      allow update: if isValidId(userId) &&
                       isValidUserSchema(incoming(), userId) &&
                       incoming().id == existing().id &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['username', 'fullName', 'role', 'password', 'hourlyRate', 'permissions', 'updatedAt']) &&
                       (isAdmin() || (isOwner(userId) && incoming().role == existing().role));
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Work Orders Collection (/workOrders/{orderId})
    // ===============================================================
    function isValidWorkOrderSchema(data, orderId) {
      let requiredKeys = ['id', 'orderNumber', 'customer', 'title', 'status', 'createdAt'];
      let allowedKeys = [
        'id', 'orderNumber', 'customer', 'title', 'description',
        'assignedWorkers', 'workerNotes', 'plannedMaterials',
        'status', 'priority', 'dueDate', 'createdAt', 'completedAt',
        'createdBy', 'closedBy', 'sastavnica', 'stoppage',
        'stoppageHistory', 'modelPreparation', 'laborRatePerHour',
        'customLaborCost', 'workerRates', 'otherCosts', 'costNotes', 'updatedAt'
      ];
      return data.keys().hasAll(requiredKeys) &&
             data.keys().hasOnly(allowedKeys) &&
             data.id == orderId &&
             data.orderNumber is string && data.orderNumber.size() >= 1 && data.orderNumber.size() <= 64 &&
             data.customer is string && data.customer.size() >= 1 && data.customer.size() <= 250 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 250 &&
             data.status in ['priprema', 'na_cekanju', 'u_izradi', 'zavrseno', 'otkazano'] &&
             data.createdAt is string && data.createdAt.size() >= 1 && data.createdAt.size() <= 64 &&
             isValidOptionalString(data, 'description', 5000) &&
             isValidOptionalString(data, 'priority', 32) &&
             isValidOptionalString(data, 'dueDate', 64) &&
             isValidOptionalString(data, 'completedAt', 64) &&
             isValidOptionalString(data, 'costNotes', 2000) &&
             isValidOptionalString(data, 'updatedAt', 64) &&
             isValidOptionalNumber(data, 'laborRatePerHour') &&
             isValidOptionalNumber(data, 'customLaborCost') &&
             isValidOptionalNumber(data, 'otherCosts') &&
             (!( 'assignedWorkers' in data ) || (data.assignedWorkers is list && data.assignedWorkers.size() <= 100)) &&
             (!( 'plannedMaterials' in data ) || (data.plannedMaterials is list && data.plannedMaterials.size() <= 200)) &&
             (!( 'stoppageHistory' in data ) || (data.stoppageHistory is list && data.stoppageHistory.size() <= 200));
    }

    match /workOrders/{orderId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() &&
                       isValidId(orderId) &&
                       isValidWorkOrderSchema(incoming(), orderId);
      allow update: if isSignedIn() &&
                       isValidId(orderId) &&
                       isValidWorkOrderSchema(incoming(), orderId) &&
                       incoming().id == existing().id &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'orderNumber', 'customer', 'title', 'description',
                         'assignedWorkers', 'workerNotes', 'plannedMaterials',
                         'status', 'priority', 'dueDate', 'completedAt',
                         'createdBy', 'closedBy', 'sastavnica', 'stoppage',
                         'stoppageHistory', 'modelPreparation', 'laborRatePerHour',
                         'customLaborCost', 'workerRates', 'otherCosts', 'costNotes', 'updatedAt'
                       ]);
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Materials Collection (/materials/{materialId})
    // ===============================================================
    function isValidMaterialSchema(data, materialId) {
      let requiredKeys = ['id', 'code', 'name', 'unit', 'currentStock', 'minStock', 'category', 'lastUpdated'];
      let allowedKeys = ['id', 'code', 'name', 'unit', 'currentStock', 'minStock', 'category', 'lastUpdated', 'createdBy', 'unitPrice'];
      return data.keys().hasAll(requiredKeys) &&
             data.keys().hasOnly(allowedKeys) &&
             data.id == materialId &&
             data.code is string && data.code.size() >= 1 && data.code.size() <= 64 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 100 &&
             data.unit in ['m3', 'm2', 'm', 'kom', 'kg', 'l', 'pak'] &&
             data.currentStock is number &&
             data.minStock is number && data.minStock >= 0 &&
             data.lastUpdated is string && data.lastUpdated.size() >= 1 && data.lastUpdated.size() <= 64 &&
             isValidOptionalNumber(data, 'unitPrice');
    }

    match /materials/{materialId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() &&
                       isValidId(materialId) &&
                       isValidMaterialSchema(incoming(), materialId);
      allow update: if isSignedIn() &&
                       isValidId(materialId) &&
                       isValidMaterialSchema(incoming(), materialId) &&
                       incoming().id == existing().id &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'code', 'name', 'unit', 'currentStock', 'minStock', 'category', 'lastUpdated', 'createdBy', 'unitPrice'
                       ]);
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Consumption Logs Collection (/consumptionLogs/{logId})
    // ===============================================================
    function isValidConsumptionLogSchema(data, logId) {
      let requiredKeys = ['id', 'workOrderId', 'workerUsername', 'materialId', 'quantity', 'timestamp'];
      let allowedKeys = [
        'id', 'workOrderId', 'workOrderNumber', 'workOrderTitle', 'customer',
        'workerUsername', 'workerName', 'materialId', 'materialName',
        'quantity', 'unit', 'hoursSpent', 'minutesSpent', 'note', 'timestamp'
      ];
      return data.keys().hasAll(requiredKeys) &&
             data.keys().hasOnly(allowedKeys) &&
             data.id == logId &&
             data.workOrderId is string && data.workOrderId.size() >= 1 && data.workOrderId.size() <= 128 &&
             data.workerUsername is string && data.workerUsername.size() >= 1 && data.workerUsername.size() <= 128 &&
             data.materialId is string && data.materialId.size() >= 1 && data.materialId.size() <= 128 &&
             data.quantity is number && data.quantity >= 0 &&
             data.timestamp is string && data.timestamp.size() >= 1 && data.timestamp.size() <= 64 &&
             isValidOptionalString(data, 'workOrderNumber', 64) &&
             isValidOptionalString(data, 'workOrderTitle', 250) &&
             isValidOptionalString(data, 'customer', 250) &&
             isValidOptionalString(data, 'workerName', 150) &&
             isValidOptionalString(data, 'materialName', 200) &&
             isValidOptionalString(data, 'unit', 32) &&
             isValidOptionalString(data, 'note', 1000) &&
             isValidOptionalNumber(data, 'hoursSpent') &&
             isValidOptionalNumber(data, 'minutesSpent');
    }

    match /consumptionLogs/{logId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() &&
                       isValidId(logId) &&
                       isValidConsumptionLogSchema(incoming(), logId);
      allow update: if isSignedIn() &&
                       isValidId(logId) &&
                       isValidConsumptionLogSchema(incoming(), logId) &&
                       incoming().id == existing().id &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'workOrderId', 'workOrderNumber', 'workOrderTitle', 'customer',
                         'workerUsername', 'workerName', 'materialId', 'materialName',
                         'quantity', 'unit', 'hoursSpent', 'minutesSpent', 'note', 'timestamp'
                       ]);
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Deleted Records Tombstone Collection (/deletedRecords/{recordId})
    // ===============================================================
    function isValidDeletedRecordSchema(data, recordId) {
      let requiredKeys = ['id', 'entityType', 'deletedAt'];
      let allowedKeys = ['id', 'entityType', 'deletedAt'];
      return data.keys().hasAll(requiredKeys) &&
             data.keys().hasOnly(allowedKeys) &&
             data.id == recordId &&
             data.entityType in ['workOrder', 'material', 'worker'] &&
             data.deletedAt is string && data.deletedAt.size() >= 1 && data.deletedAt.size() <= 64;
    }

    match /deletedRecords/{recordId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin() &&
                       isValidId(recordId) &&
                       isValidDeletedRecordSchema(incoming(), recordId);
      allow update: if isAdmin() &&
                       isValidId(recordId) &&
                       isValidDeletedRecordSchema(incoming(), recordId) &&
                       incoming().id == existing().id &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['entityType', 'deletedAt']);
      allow delete: if isAdmin();
    }
  }
}
